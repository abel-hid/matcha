FLASK_APP=run.py
FLASK_DEBUG=false

BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

SECRET_KEY=replace_with_a_long_random_secret
JWT_SECRET_KEY=replace_with_a_different_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=false

POSTGRES_USER=matcha
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=matcha
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MatchaSchoolProject/1.0
NOMINATIM_TIMEOUT_SECONDS=8

FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
